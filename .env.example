# Example environment variables for IVASTBOT (do NOT store real secrets here)
# Fill values before running the app. Keep this file in repo; do NOT commit real .env.

# OpenAI API key (used by embedding / tts workers)
OPENAI_API_KEY=

# Workspace root used by some embedding/ros launch scripts (optional)
WS_ROOT=

# ChromaDB path (optional override; default set in backend/LLM.py)
CHROMA_DB_PATH=backend/iop_chromadb

# Ollama model name (local model pulled via `ollama pull`)
OLLAMA_MODEL=qwen2.5:7b

# Example: other vars you might need
# OTHERVAR=
